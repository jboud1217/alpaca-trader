# $10,000 account — the practical floor for defensible sizing.
#
# A 3-wide spread risking ~$260 is 2.6% of the account, which is a normal
# per-trade risk rather than a bet. This is the smallest size where the
# arithmetic stops fighting you.
#
# Still under the $25,000 PDT threshold: three day trades per five business
# days. 3-DTE holds average ~2 days so most do not count, but a same-session
# profit-target close does.

EQUITY=10000
RISK_FRAC=0.03
MAX_RISK_PER_TRADE=300
MAX_CONTRACTS=1

MAX_OPEN_RISK=900
MAX_NEW_RISK_PER_DAY=900
MAX_ORDERS_PER_DAY=8

TARGET_DTE=3
WING_WIDTH=3
SHORT_DELTA=0.30
MIN_DTE=1
PROFIT_TAKE=0.50
STOP_MULT=2.0

# A proposal older than this is not consent. At 3-DTE credits move fast --
# three of the first several confirmations were refused for price movement,
# which means stale proposals were being shown. 600s keeps quotes fresh; the
# re-price gate below is the backstop for what still slips through.
APPROVAL_TTL=600
REPRICE_TOLERANCE=0.10

SYMBOLS=SPY,QQQ,IWM
THRESHOLD=0.15
