# $2,500 account — the smallest size at which this strategy can trade at all.
#
# READ THIS BEFORE APPLYING IT.
#
# A 3-wide SPY/IWM credit spread risks $238–259 per contract. On $2,500 that is
# ~10% of the account on a single trade. There is no way around it: narrower
# spreads are affordable but their friction turns expectancy negative
# (1-wide measured -$0.90/trade, 2-wide -$0.20), and wider spreads are not
# affordable at all. $2,500 sits below the size where this instrument works.
#
# Measured on 280 real trades at 3-DTE / 3-wide:
#     expectancy      +$1.52 per trade  (t = 0.31)
#     95% CI          -$8.25 .. +$11.29 — spans zero
#     expected month  ~$24 = 0.95% of the account
#     12-month sim    19.1% chance of losing half the account
#
# So this profile is defensible as TUITION — a bounded amount spent to learn
# real fill quality, which no backtest or paper run can supply — and not as an
# investment. If the goal is returns rather than measurement, fund to $10,000
# and use mid-10000.env, where the same trade is 3% of the account instead
# of 10%.
#
# PDT: under $25,000 in a margin account you get three day trades per five
# business days. 3-DTE positions average ~2 days held so most do not count,
# but a same-session profit-target close does. Breaching it restricts the
# account for 90 days.

EQUITY=2500
# 11% rather than 10%: a $250 budget silently excluded IWM, whose 3-wide spread
# risks $257. Losing a third of the symbols to a $7 gap is a worse outcome than
# one extra point of nominal risk.
RISK_FRAC=0.11
MAX_RISK_PER_TRADE=275
MAX_CONTRACTS=1

# Two concurrent positions maximum. Three symbols could otherwise put ~31% of
# the account at risk simultaneously, and these are correlated index ETFs — they
# would not fail independently.
MAX_OPEN_RISK=550
MAX_NEW_RISK_PER_DAY=550
MAX_ORDERS_PER_DAY=3

# Strategy shape: the best measurement instrument from the DTE sweep — highest
# t-statistic, lowest friction, ~15 trades/month instead of 2.4.
TARGET_DTE=3
WING_WIDTH=3
SHORT_DELTA=0.30
MIN_DTE=1
PROFIT_TAKE=0.50
STOP_MULT=2.0

# A proposal older than this is not consent. At 3-DTE credits move fast --
# three of the first several confirmations were refused for price movement,
# which means stale proposals were being shown. 600s keeps quotes fresh; the
# re-price gate below is the backstop for what still slips through.
APPROVAL_TTL=600
REPRICE_TOLERANCE=0.10

SYMBOLS=SPY,QQQ,IWM
THRESHOLD=0.15
