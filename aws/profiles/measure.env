# Measurement profile — maximise trade count, ignore account-level sizing.
#
# For establishing whether an edge exists, what matters is PER-CONTRACT
# expectancy and how many observations you gather. Account sizing is a separate
# decision made later with the answer in hand. So this profile sets a budget
# generous enough that no symbol is excluded, and caps contracts at 1 so every
# observation carries equal weight.
#
# This is what the paper environment should run while accumulating data.

# 2026-10-23 forward test: the 14-DTE / 2%-wide structure risks ~$1,230 per
# SPY or QQQ contract and ~$440 per IWM. Equity is the paper account's real
# size; budget = min(100000 x 0.015, 1500) = $1,500, one contract.
EQUITY=100000
RISK_FRAC=0.015
MAX_RISK_PER_TRADE=1500
MAX_CONTRACTS=1

# One position per symbol: ~1230 + 1230 + 440 = ~$2,900 if all three are on.
# That is the worst case -- all three at max loss in one move, ~3% of equity.
# Per-underlying cap is 50% of this ($1,750), above one SPY spread.
MAX_OPEN_RISK=3500
MAX_NEW_RISK_PER_DAY=3500
# The daily control is CAPITAL, not trade count. MAX_ORDERS_PER_DAY=none
# because a count cap measured the wrong thing: closes consumed it too, so a
# day of exits locked out entries while almost no money was at risk. On
# 2026-09-03 an open/close loop spent six of eight slots in five minutes.
# MAX_NEW_RISK_PER_DAY is enforced NET of realised P&L -- a winner hands the
# capital back and frees room; a loser tightens it.
MAX_ORDERS_PER_DAY=none

# 6, not 3. Measured 2026-09-09 off the chain inspector: mid-week expiries
# carry only $5 strikes with two-sided markets, so wing_width=3 silently
# becomes 5 and defined risk lands ~$470 -- refused by the per-trade budget.
# Fridays are $1-laddered. Worse, the dte 5-8 band is the BEST priced on the
# board (SPY $96 credit at 0.031 spread frac vs $53 at dte 2), and it was
# being refused on budget rather than on quality. 500 covers a $5-wide.
TARGET_DTE=6
WING_WIDTH=3
# 0.20, not 0.30, and stop 1.5x not 2.0x. Measured on 40 live closes:
#   profit target  configured 0.50x credit -> REALISED 0.53x   (as designed)
#   stop           configured 2.00x credit -> REALISED 3.15x   (worst 6.17x)
# The stop overshot because manage shared the 5-minute scan cadence, and at
# 3-6 DTE a spread travels a long way between polls. On realised multiples the
# rule set needed an 85.6% win rate against 70% delta-implied -- negative by
# construction, which is exactly what -$40.30/trade over 40 trades looks like.
# Manage now runs every minute (ManageCron), 1.5x should realise nearer 2.0x,
# and 0.20 delta raises the implied rate to 80%. Required 79.1% vs 80% implied
# is the first configuration where the arithmetic is not upside down.
# It removes a guaranteed loss. It does not create an edge -- the chain is
# still priced at fair value, and no exit rule changes that.
SHORT_DELTA=0.20

# ---- FORWARD TEST, from 2026-10-23 -- overrides the three lines above -------
# structure_study.py swept 48 shapes; none qualified. 0.30 delta / 2% of spot /
# 14 DTE is the ONE cell positive (delta-hedged) on all three symbols, in both
# halves of the window, and at slippage 1.0: hedged +2.82% of risk per trade,
# t=+1.19 -- not significant, and chosen as the best of 48, so its in-sample
# number is biased upward. Only out-of-sample trades can say anything, which
# is the point of running it. The deployed 0.20 / ~1% / 6-DTE shape hedges to
# -0.20% (fair value), so continuing it would only re-confirm a known zero.
TARGET_DTE=14
SHORT_DELTA=0.30
# Fraction of spot, as the study measured it: $14 on SPY/QQQ, $5 on IWM.
# WING_WIDTH above is the fallback when this is unset.
WING_WIDTH_PCT=0.02
# -----------------------------------------------------------------------------

# 2026-10-23: HOLD TO EXPIRY. No profit target, no stop, no min_dte roll-off.
# Measured on 94 live round trips (2026-08-13 .. 10-21), each one re-priced as
# if held to the expiry close:
#                          per trade      t
#   as managed               -$18.70   -3.07
#   same trades, held         -$1.30   -0.13    <- fair value, as the backtest said
#   paired difference        -$17.40   -2.12    (-1.40 clustered by expiry week)
# By exit reason, managed vs held:
#   profit target  n=46   +$24.10 vs +$41.70   left $17/trade, paired t=-13
#   stop           n=35   -$80.40 vs -$60.30   20 of 33 would have expired worthless;
#                                              19 of 35 fired 09:30-10:00 ET
# The stop triggered on the CROSSING price, so the quoted width of both legs
# (~$11 measured, ~0.3x credit) sat inside it, and the opening half hour is
# where that width is largest. Independent check, real 2024 SPY NBBO, same
# structure: deployed exits -$2.70/trade, hold +$8.70 (bull tape; read the
# ordering, not the level). Literature agrees there is nothing for the rules
# to capture: under a random walk a stop lowers expected return (Kaminski &
# Lo), and Santa-Clara & Saretto (2009) attribute most of the lost short-
# option premium to spreads and forced exits.
#
# The wing is the stop. Max loss is width - credit (~$260/contract), and it
# was always the binding risk control; the 1.5x stop only decided WHEN to
# realise a loss the wing had already capped.
MIN_DTE=0
PROFIT_TAKE=none
STOP_MULT=none
# Rules trigger on the mid now (handlers._exit_verdict); closes are still
# priced at the crossing side. No exit decision in the first half hour.
QUIET_OPEN_MINUTES=30
# Expiry day: in the last 30 minutes, close any spread whose short strike is
# not at least 1% below spot (assignment / after-hours pin risk). The rest
# expire worthless and pay no exit spread at all.
EXPIRY_CLOSE_MINUTES=30
PIN_BUFFER=0.01

# Enter between 60 and 10 minutes before the close. Half of the first 94
# entries filled in the opening half hour, at the day's widest option markets,
# and index option returns are earned overnight, ~zero intraday (Muravyev &
# Ni 2020): a 09:35 entry holds six hours of nothing before the part that pays.
ENTRY_MINUTES_BEFORE_CLOSE=60
ENTRY_CUTOFF_MINUTES=10

# Stand aside when the term structure is inverted (front IV over back).
# Johnson (2017): the VIX slope predicts variance-seller returns, and it is the
# best-supported timing signal there is. NOT a level filter: Cheng (2019)
# finds the premium does not rise with IV, so "sell when vol is high" and IV
# rank have no support. Proxy is ATM IV 55 vs 14 DTE on the traded chain.
VETO_INVERTED_TERM=on
TERM_SLOPE_FLOOR=0.0

# PRE-REGISTERED, so the next look cannot move the goalposts.
# Judged on HEDGED P&L (journal field hedged_pnl: realised minus entry
# position delta x the underlying's move), as a fraction of max loss -- the
# study's metric. Raw P&L is reported but decides nothing: it is mostly beta.
# Review at 30 round trips (~20 weeks: one 14-DTE position per symbol at a
# time) and at every 10 before that:
#   - KILL (revert to the 6-DTE shape, or disarm) if hedged return-on-risk
#     is below -3% at any review from 10 trades on. The in-sample estimate is
#     +2.8%; -3% is about two block-bootstrap standard errors below it.
#   - CONTINUE to 60 trades if it is above 0 at 30. Not "it works": 30
#     trades of a +2.8% effect cannot reach significance. It earns more data.
#   - Anything between: inconclusive, run to 60 before deciding.
# Expected outcome remains roughly zero. A best-of-48 cell shrinks toward the
# grid mean out of sample, and the grid mean hedged was negative.

# A proposal older than this is not consent. At 3-DTE credits move fast --
# three of the first several confirmations were refused for price movement,
# which means stale proposals were being shown. 600s keeps quotes fresh; the
# re-price gate below is the backstop for what still slips through.
APPROVAL_TTL=600
REPRICE_TOLERANCE=0.10

SYMBOLS=SPY,QQQ,IWM
THRESHOLD=0.15
