.venv/
__pycache__/
*.pyc

# Downloaded Alpaca history. Large (hundreds of MB) and fully reproducible.
.cache/

# Never commit credentials.
.env
*.env

# Runtime state — never commit
pending.json
orders.jsonl
suggestions.jsonl
alerts.log
alerts.err
KILL_SWITCH
com.alpaca.alerts.plist

# Embeds the reply topic — this file can authorize trades.
reply.html

# ...but the AWS sizing profiles are pure config (EQUITY, RISK_FRAC, WING_WIDTH
# and friends -- no credentials), and they define the risk limits the deployed
# stack enforces. They belong in version control.
!aws/profiles/*.env

# SAM build output -- regenerated by `sam build`, not source.
aws/.aws-sam/
